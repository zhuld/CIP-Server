<?xml version="1.0" encoding="utf-8"?>
<!--
  说明: 运行时配置。高 DPI 感知不在此配置，见 app.manifest（SystemAware，
        由操作系统在进程创建时读取，不依赖框架配置解析）。
  注意: <System.Windows.Forms.ApplicationConfigurationSection> 的 DpiAwareness 键
        仅接受 "PerMonitorV2" 或 "false"——没有 SystemAware 取值，写成 SystemAware
        会被静默忽略（已实测：进程停留在 Unaware、界面被系统位图拉伸而模糊）。
        另外该内置节**不可**再写进 <configSections> 重复声明，否则启动即抛
        "配置系统未能初始化"（已实测）。
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
